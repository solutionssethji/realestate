# Environment Flags
# Set to 'true' to use Firebase Emulators during local development
USE_FIREBASE_EMULATORS=false

# Google Maps
GOOGLE_MAPS_API_KEY_ANDROID="your-android-maps-api-key"
GOOGLE_MAPS_API_KEY_IOS="your-ios-maps-api-key"

# Application
COMPANY_SUPPORT_EMAIL="support@yourcompany.com"
COMPANY_SUPPORT_PHONE="+91-0000000000"
COMPANY_WHATSAPP="+91-0000000000"
