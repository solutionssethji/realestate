rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isLoggedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // User can read/write own profile. Admin can read all.
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // User notifications subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ─── Admins ──────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── Agents ──────────────────────────────────────────────────────────────
    match /agents/{agentId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── Projects ────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if true; // Public: anyone can view projects
      allow write: if isAdmin();
    }

    // ─── Plots ───────────────────────────────────────────────────────────────
    match /plots/{plotId} {
      allow read: if true; // Public: anyone can view plots
      allow write: if isAdmin();
    }

    // ─── Offers ──────────────────────────────────────────────────────────────
    match /offers/{offerId} {
      allow read: if true; // Public: anyone can view offers
      allow write: if isAdmin();
    }

    // ─── Enquiries ───────────────────────────────────────────────────────────
    match /enquiries/{enquiryId} {
      // User can read their own enquiry. Admin can read all.
      allow read: if isAdmin() || (isLoggedIn() && resource.data.customerId == request.auth.uid);
      // Logged-in users can create. Admin can update.
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ─── Site Visits ─────────────────────────────────────────────────────────
    match /siteVisits/{visitId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ─── Assign Plots (Bookings) ──────────────────────────────────────────────
    match /assignPlots/{bookingId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.customerId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false; // Never delete bookings
    }

    // ─── Payments ────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.customerId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ─── Admin Notifications ──────────────────────────────────────────────────
    match /adminNotifications/{notifId} {
      allow read, write: if isAdmin();
      // Mobile app can create new notifications (for enquiry/site-visit triggers)
      allow create: if isLoggedIn();
    }

    // ─── Documents (User Uploaded) ────────────────────────────────────────────
    match /documents/{docId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ─── Contact Us ──────────────────────────────────────────────────────────
    match /contactUs/{contactId} {
      allow read: if isAdmin();
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ─── Settings ────────────────────────────────────────────────────────────
    match /setting/{settingId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── Wishlist ────────────────────────────────────────────────────────────
    match /wishlist/{wishId} {
      allow read, write: if isLoggedIn() && resource.data.customerId == request.auth.uid;
      allow create: if isLoggedIn();
    }

    // ─── Counters (for payment voucher numbering) ─────────────────────────────
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // ─── Referral ────────────────────────────────────────────────────────────
    match /referral/{referralId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
  }
}
