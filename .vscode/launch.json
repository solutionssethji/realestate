{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shubhaytanam Admin",
      "request": "launch",
      "type": "node-terminal",
      "command": "npm start -- -p 3002",
      "cwd": "${workspaceFolder}/admin"
    },
    {
      "name": "Shubhaytanam Connect",
      "request": "launch",
      "type": "dart",
      "program": "mobile/lib/main.dart"
    },
    {
      "name": "Shubhaytanam Connect (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "mobile/lib/main.dart"
    },
    {
      "name": "Shubhaytanam Connect (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "mobile/lib/main.dart"
    }
  ]
}