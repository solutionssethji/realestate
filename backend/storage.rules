rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      // In a real app, this would verify a custom claim or check Firestore (not natively supported in Storage rules without custom claims).
      // For now, we assume if you are authenticated, you might be an admin for uploads.
      // Ideally, custom claims are set by Cloud Functions.
      return request.auth != null && request.auth.token.admin == true;
    }
    
    match /{allPaths=**} {
      // Public can read media
      allow read: if true;
      
      // Only Admins can upload/delete
      // Note: During local emulator testing without custom claims, we might temporarily allow all authenticated users.
      // allow write: if request.auth != null; 
      allow write: if request.auth != null; // Relaxed for emulator demo purposes, restrict in production.
    }
  }
}
