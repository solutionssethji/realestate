rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null;
    }
    
    // CUSTOMER PUBLIC READS
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /plots/{plotId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // CUSTOMER WRITES (Enquiries & Site Visits)
    match /enquiries/{enquiryId} {
      allow create: if true; 
      allow read, update, delete: if isAdmin();
    }
    
    match /siteVisits/{siteVisitId} {
      allow create: if true; 
      allow read, update, delete: if isAdmin(); 
    }
    
    // NOTIFICATIONS
    match /adminNotifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }
    
    // USERS (Customers of the mobile app)
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }
    
    // CUSTOMER PLOTS (Private ownership data)
    match /assignPlots/{customerPlotId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.token.phone_number == resource.data.mobileNumber) || isAdmin();
      allow write: if isAdmin();
    }
    
    // PAYMENTS (Private transaction history)
    match /payments/{paymentId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.token.phone_number == resource.data.mobileNumber) || isAdmin();
      allow write: if isAdmin();
    }

    // Sequential payment voucher counters
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
    
    // TRANSACTIONS
    match /transactions/{transactionId} {
      allow read, write: if isAdmin();
    }
    
    // BOOKINGS
    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
      allow create: if request.auth != null; // Allows users to create bookings
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid; // Read own
    }
    
    // ADMINS
    match /admins/{adminId} {
      allow read: if true; // Allow public read so forgot-password can query email
      allow write: if isAdmin();
    }
    
    // AGENTS
    match /agents/{agentId} {
      // Public read allowed so forgot-password page can verify agent email without auth
      // Write is restricted to admins only
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // APP SETTINGS & CONTENT
    
    match /setting/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
